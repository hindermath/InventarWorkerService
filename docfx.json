{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "InventarWorkerCommon/InventarWorkerCommon.csproj",
            "CtrlWorkerCommon/CtrlWorkerCommon.csproj",
            "CtrlWorkerServiceCmdlet/CtrlWorkerServiceCmdlet.csproj"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "README.md",
          "docs/**/*.md",
          "docs/toc.yml",
          "api/**/*.yml",
          "api/.manifest"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "*.png",
          "images/**",
          "docs/**.pdf"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "InventarWorkerService",
      "_appTitle": "InventarWorkerService",
      "_enableSearch": true,
      "pdf": true,
      "_sourcePathStyle": "unix"
    }
  }
}
